{
  "kind": "collectionType",
  "collectionName": "leads",
  "info": {
    "singularName": "lead",
    "pluralName": "leads",
    "displayName": "Lead / Enquiry"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "budgetRange": {
      "type": "string"
    },
    "preferredContact": {
      "type": "string"
    },
    "message": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "proposal_sent",
        "won",
        "lost",
        "spam"
      ],
      "default": "new"
    },
    "priority": {
      "type": "enumeration",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "default": "normal"
    },
    "source": {
      "type": "string"
    },
    "pagePath": {
      "type": "string"
    },
    "assignedTo": {
      "type": "string"
    },
    "followUpDate": {
      "type": "date"
    },
    "dealValue": {
      "type": "decimal"
    },
    "notes": {
      "type": "text"
    }
  }
}
