# Strapi Server Configuration
HOST=0.0.0.0
PORT=1337

# Secrets (Generate custom strings in production via `openssl rand -base64 32`)
APP_KEYS=skoventoKeyA,skoventoKeyB,skoventoKeyC,skoventoKeyD
API_TOKEN_SALT=skoventoApiTokenSalt_ChangeMeInProd123456789
ADMIN_JWT_SECRET=skoventoAdminJwtSecret_ChangeMeInProd123456789
TRANSFER_TOKEN_SALT=skoventoTransferTokenSalt_ChangeMeInProd

# Database (Default is SQLite for zero-config local development)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# If using PostgreSQL in production:
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:password@host:5432/skovento_cms
# DATABASE_SSL=true
