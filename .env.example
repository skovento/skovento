# ---- Admin login (required) ----
ADMIN_EMAIL=you@example.com
# Preferred: npm run admin:hash -- "your long password"  ->  paste the printed value
ADMIN_PASSWORD_HASH=
# Local development only (leave empty in production):
ADMIN_PASSWORD=
# 32+ random characters, e.g. openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ---- Storage ----
# Leave empty locally (data is saved to .data/cms.json).
# In production set a Postgres connection string; tables are created automatically.
CMS_DATABASE_URL=

# ---- Optional ----
# Email notification for new enquiries (Resend)
RESEND_API_KEY=
NOTIFICATION_EMAIL=
FROM_EMAIL=
# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Kill switch: noindex header on everything regardless of admin setting (staging / previews)
FORCE_NOINDEX=true
