# ---- Admin login (required) ----
ADMIN_EMAIL=you@example.com
# Preferred: npm run admin:hash -- "your long password"  ->  paste the printed value
ADMIN_PASSWORD_HASH=
# Local development only (leave empty in production):
ADMIN_PASSWORD=
# 32+ random characters, e.g. openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ---- Storage ----
# Leave empty locally (data is saved to .data/cms.json).
# In production set a Postgres connection string; tables are created automatically.
CMS_DATABASE_URL=

# ---- Optional ----
# Email alert for new enquiries via SMTP (recommended). Test: node --env-file=.env.local scripts/mail-test.mjs
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# e.g.  Skovento Website <hello@skovento.com>   (empty = SMTP_USER)
SMTP_FROM=
# Who receives the alert (comma-separated allowed; empty = SMTP_USER)
NOTIFICATION_EMAIL=
# Old alternative (only used when SMTP_* is not set): Resend
RESEND_API_KEY=
FROM_EMAIL=
# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Kill switch: noindex header on everything regardless of admin setting (staging / previews)
FORCE_NOINDEX=true
